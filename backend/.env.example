# PostgreSQL (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://opkit:opkit@localhost:5432/opkit?schema=public"

# Redis — used as the Socket.IO adapter backend so real-time events
# fan out correctly even if the API ever runs as more than one instance
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# HTTP server
PORT=3000

# Allowed origin for CORS / WebSocket (the frontend dev server)
CORS_ORIGIN="http://localhost:5173"
